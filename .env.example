# ==============================================================================
# KaizenBMS Platform — environment variables
# Copy this file to .env.local and fill in real values there.
# NEVER commit .env.local — it holds real secrets.
# ==============================================================================

# ---- DATABASE ----------------------------------------------------------------
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# ---- APPLICATION ---------------------------------------------------------------
# Fully-qualified, no trailing slash (e.g. https://app.yourdomain.com).
# REQUIRED for BillDesk's redirect-based checkout (return URL must be
# absolute) and for links in outgoing emails.
NEXT_PUBLIC_APP_URL=

# ---- EMAIL (existing, used for welcome/receipt/notification emails) ----------
EMAIL_USER=
EMAIL_PASS=
SMTP_HOST=
SMTP_PORT=

# ---- AUTH / CRON (existing) ----------------------------------------------------
CRM_JWT_SECRET=
CRON_SECRET=

# ---- BILLDESK (company subscription billing — the platform's only payment
# gateway) --------------------------------------------------------------------
# IMPORTANT: this list is a best-guess scaffold, not a confirmed requirement.
# This project does not yet have BillDesk's official merchant integration
# document. The actual set of variables BillDesk's integration needs (which
# of these apply, and whether any additional ones — e.g. a separate checksum
# key, a key-id, a certificate — are required) is confirmed once that
# document is available; see src/lib/payments/billdeskClient.js for the one
# place all of this is read, and where the real implementation goes once the
# spec is known. Never hardcode any of these values in code.
BILLDESK_ENVIRONMENT=sandbox
BILLDESK_MERCHANT_ID=
BILLDESK_CLIENT_ID=
BILLDESK_CLIENT_SECRET=
BILLDESK_SECRET_KEY=
BILLDESK_WEBHOOK_SECRET=

# ==============================================================================
# Webhook URL to register with BillDesk once NEXT_PUBLIC_APP_URL is set:
#   {NEXT_PUBLIC_APP_URL}/api/webhooks/billdesk
# ==============================================================================
