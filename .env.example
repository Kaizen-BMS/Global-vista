# ==============================================================================
# KaizenBMS Platform — environment variables
# Copy this file to .env.local and fill in real values there.
# NEVER commit .env.local — it holds real secrets.
# ==============================================================================

# ---- DATABASE ----------------------------------------------------------------
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# ---- APPLICATION ---------------------------------------------------------------
# Fully-qualified, no trailing slash (e.g. https://app.yourdomain.com).
# REQUIRED for PayPal's redirect-based checkout (return_url/cancel_url must be
# absolute) and for links in outgoing emails. Currently unset on this
# environment — set it before relying on any PayPal checkout flow.
NEXT_PUBLIC_APP_URL=

# ---- EMAIL (existing, used for welcome/receipt/notification emails) ----------
EMAIL_USER=
EMAIL_PASS=
SMTP_HOST=
SMTP_PORT=

# ---- AUTH / CRON (existing) ----------------------------------------------------
CRM_JWT_SECRET=
CRON_SECRET=

# ---- RAZORPAY (company subscription billing) ----------------------------------
# Get these from the Razorpay Dashboard > Settings > API Keys.
# Mode (test/live) is inherent in which key pair you use — Razorpay issues
# separate rzp_test_... / rzp_live_... keys, there is no separate mode flag.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From Dashboard > Settings > Webhooks, after creating the webhook (see below).
RAZORPAY_WEBHOOK_SECRET=

# ---- PAYPAL (company subscription billing) -------------------------------------
# Get these from the PayPal Developer Dashboard > Apps & Credentials.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
# From the PayPal Developer Dashboard, after creating the webhook (see below).
PAYPAL_WEBHOOK_ID=

# ==============================================================================
# Webhook URLs to register in each gateway's dashboard once NEXT_PUBLIC_APP_URL
# is set:
#   Razorpay: {NEXT_PUBLIC_APP_URL}/api/webhooks/razorpay
#   PayPal:   {NEXT_PUBLIC_APP_URL}/api/webhooks/paypal
# ==============================================================================
